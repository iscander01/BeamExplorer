{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "./src/@types"
    ],
    "types": ["node"],
    "baseUrl": "src/",
    "paths": {
      "@app/*": ["app/*"],
      "@core/*": ["app/core/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}
