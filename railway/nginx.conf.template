# Railway: static server for the frontend bundle. Data comes from the public
# BeamTerminal API — the bundle calls https://beamterminal.0xmx.net/api
# directly from the browser (open CORS), so there is nothing to proxy here.
# Cache rules mirror ../nginx.conf. Rendered by the nginx image's envsubst:
# only ${PORT} is substituted; nginx's own $variables pass through.

server {
  listen ${PORT};
  listen [::]:${PORT};

  root /usr/share/nginx/html;
  index index.html;

  # SPA: any path serves index.html, whose head script moves the path into the
  # hash (HashRouter) — /explorer/charts, /block?kernel_id=…, /assets/details/7.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # index.html references content-hashed assets, so it must always revalidate.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # Content-hashed JS/CSS never changes under the same name — cache forever.
  location ~* "\.[0-9a-f]{8}\.(js|css)$" {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/wasm;
  gzip_min_length 1024;
}
